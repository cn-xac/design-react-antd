{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@x-ac/web-design-react-antd": ["src/index.tsx"],
      // 引擎依赖 @x-ac/web-design-core / @x-ac/web-design-react 的已发布版本（^1.0.0），由 node_modules 解析类型
      // React 本身不带 .d.ts，类型来自 @types/react；这里强制把本包与引擎依赖里的
      // `import type ... from "react"` 收敛到本仓单一副本，避免两份 @types/react 互不兼容。
      // （与 Vue 版不同：vue 包自带类型，可直指 node_modules/vue）
      "react": ["node_modules/@types/react"],
      "react-dom": ["node_modules/@types/react-dom"]
    },
    "types": ["vite/client", "node", "react", "react-dom"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "env.d.ts"]
}
